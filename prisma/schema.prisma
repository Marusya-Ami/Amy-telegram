generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RelationshipStage {
  NEW
  ACQUAINTANCE
  ENGAGED
  CLOSE
  VIP
  DORMANT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  USER
  AMY
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  PAYMENT
  SYSTEM
}

enum TelegramUpdateStatus {
  PROCESSING
  DONE
  FAILED
}

model User {
  id                  String            @id @default(cuid())
  telegramUserId      String            @unique
  username            String?
  firstName           String?
  lastName            String?
  languageCode        String?
  relationshipStage   RelationshipStage @default(NEW)
  conversationSummary String?           @db.Text
  aiEnabled           Boolean           @default(true)
  proactiveEnabled    Boolean           @default(true)
  messagesCount       Int               @default(0)
  totalStarsSpent     Int               @default(0)
  lastUserMessageAt   DateTime?
  lastAmyMessageAt    DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  conversations Conversation[]
  messages      Message[]

  @@index([lastUserMessageAt])
  @@index([relationshipStage])
}

model Conversation {
  id                     String   @id @default(cuid())
  userId                 String
  platform               String
  platformConversationId String
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([platform, platformConversationId])
  @@index([userId])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  userId            String
  direction         MessageDirection
  sender            MessageSender
  type              MessageType
  text              String?          @db.Text
  telegramMessageId String?
  replyToMessageId  String?
  metadata          Json?
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, telegramMessageId])
  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@index([direction, createdAt])
}

model TelegramUpdate {
  id               String               @id @default(cuid())
  updateId         String               @unique
  status           TelegramUpdateStatus @default(PROCESSING)
  inboundMessageId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, updatedAt])
}
